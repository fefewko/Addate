{
  "expo": {
    "name": "ADDate",
    "slug": "ADDate",
    "version": "0.0.36",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "addate",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#121212",
    "ios": {
      "icon": "./assets/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f9faf5",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.addate.ADDate",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "ADDate",
      "shortName": "ADDate",
      "lang": "ru",
      "themeColor": "#121212",
      "backgroundColor": "#121212",
      "description": "Знакомства для своих",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/web",
      "scope": "/web"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Разрешите доступ к галерее, чтобы выбрать фото профиля."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Разрешите доступ к геолокации, чтобы показывать анкеты поблизости от вас."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3b82f6"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121212",
          "image": "./assets/splash-logo.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "reactCompiler": true,
      "baseUrl": "/web"
    },
    "extra": {
      "eas": {
        "projectId": "b8ddd62f-d8e0-4863-b81a-63a15b1b9f8f"
      }
    }
  }
}
